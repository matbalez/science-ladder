  "$id": "https://github.com/matbalez/science-ladder/blob/main/protocol/schemas/runner-job-v1.schema.json",
  "$ref": "#/$defs/RunnerJob",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Science Ladder RunnerJob v1"
}
